<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RepositoryUrl>https://github.com/ruifrvaz/Daisy-m4</RepositoryUrl>
  </PropertyGroup>

  <!-- Ensures that plugins are loaded into the binary folder to allow ingestion during runtime -->
  <PropertyGroup>
    <DaisyPluginCollector>true</DaisyPluginCollector>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daisy.Resources\Daisy.Resources.csproj" />
    <ProjectReference Include="..\Daisy.Factories\Daisy.Factories.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appconfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>