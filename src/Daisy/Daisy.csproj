<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RepositoryUrl>https://github.com/ruifrvaz/Daisy-m4</RepositoryUrl>
  </PropertyGroup>

  <!-- Plugin collector no longer needed - using direct project references -->
  <PropertyGroup>
    <DaisyPluginCollector>false</DaisyPluginCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daisy.Resources\Daisy.Resources.csproj" />
    <ProjectReference Include="..\Daisy.Factories\Daisy.Factories.csproj" />
    <!-- Plugin Project References - Direct dependencies instead of runtime loading -->
    <ProjectReference Include="..\Daisy.Abilities\Daisy.Abilities.Operator\Daisy.Abilities.Operator.csproj" />
    <ProjectReference Include="..\Daisy.Abilities\Daisy.Abilities.OutputValidator\Daisy.Abilities.OutputValidator.csproj" />
    <ProjectReference Include="..\Daisy.Abilities\Daisy.Abilities.Terminate\Daisy.Abilities.Terminate.csproj" />
    <ProjectReference Include="..\Daisy.Abilities\Daisy.Abilities.Weather\Daisy.Abilities.Weather.csproj" />
    <ProjectReference Include="..\Daisy.Receivers\Daisy.Receivers.Console\Daisy.Receivers.Console.csproj" />
    <ProjectReference Include="..\Daisy.Receivers\Daisy.Receivers.WeatherEvent\Daisy.Receivers.WeatherEvent.csproj" />
    <ProjectReference Include="..\Daisy.Transmitters\Daisy.Transmitters.Console\Daisy.Transmitters.Console.csproj" />
    <ProjectReference Include="..\Daisy.Transmitters\Daisy.Transmitters.WorkflowTrigger\Daisy.Transmitters.WorkflowTrigger.csproj" />
    <ProjectReference Include="..\Daisy.Workflows\Daisy.Workflows.Starter\Daisy.Workflows.Starter.csproj" />
    <ProjectReference Include="..\Daisy.Workflows\Daisy.Workflows.TryMe\Daisy.Workflows.Weather.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appconfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>